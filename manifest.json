{
  "manifest_version": 3,
  "name": "Hold to Speed Up for TikTok - 2x Video Speed",
  "short_name": "Hold to Speed Up",
  "version": "2.0.0",
  "description": "Hold on a TikTok video to play it at 2x, like the mobile app. Let go and it keeps playing. Pick 1.5x to 3x or set a hold key.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*"
      ],
      "js": [
        "js/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "html/popup.html",
    "default_title": "Hold to Speed Up",
    "default_icon": {
      "16": "images/icons/icon-16.png",
      "32": "images/icons/icon-32.png",
      "48": "images/icons/icon-48.png"
    }
  },
  "icons": {
    "16": "images/icons/icon-16.png",
    "32": "images/icons/icon-32.png",
    "48": "images/icons/icon-48.png",
    "128": "images/icons/icon-128.png"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Turn Hold to Speed Up on or off"
    }
  }
}
